<odoo noupdate="1">
    <record forcecreate="True" id="base.co" model="res.country">
        <field name="enforce_cities">True</field>
        <field name="state_required">True</field>
        <field
            name="address_format"
            eval="'%(street)s\n%(street2)s\n%(city)s, %(state_name)s %(zip)s %(country_name)s'"
        />
    </record>
</odoo>
