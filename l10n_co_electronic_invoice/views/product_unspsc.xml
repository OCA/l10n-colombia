<odoo>
    <!-- UNSPSC -->
    <record id="view_product_unspsc_form" model="ir.ui.view">
        <field name="name">view_product_unspsc_form</field>
        <field name="model">product.unspsc</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <group>
                        <group>
                            <field name="product_code" />
                            <field name="name" />
                            <field name="segment_code" />
                            <field name="segment_name" />
                        </group>
                        <group>
                            <field name="family_code" />
                            <field name="family_name" />
                            <field name="class_code" />
                            <field name="class_name" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="view_product_unspsc_list">
        <field name="name">view_product_unspsc_list</field>
        <field name="model">product.unspsc</field>
        <field name="arch" type="xml">
            <list>
                <field name="product_code" />
                <field name="name" />
                <field name="segment_code" />
                <field name="segment_name" />
                <field name="family_code" />
                <field name="family_name" />
                <field name="class_code" />
                <field name="class_name" />
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="product_unspsc_action_window">
        <field name="name">UNSPSC</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.unspsc</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Sin UNSPSC definidos
            </p>
        </field>
    </record>
</odoo>
