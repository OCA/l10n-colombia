<odoo>
    <!-- Tipo Impuesto -->
    <record id="view_l10n_co_tax_type_form" model="ir.ui.view">
        <field name="name">view_l10n_co_tax_type_form</field>
        <field name="model">l10n_co.tax.type</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <group>
                        <group>
                            <field name="code" />
                            <field name="name" />
                        </group>
                        <group>
                            <field name="is_withholding_tax" widget="boolean_toggle" />
                            <field name="active" widget="boolean_toggle" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="view_l10n_co_tax_type_list">
        <field name="name">view_l10n_co_tax_type_list</field>
        <field name="model">l10n_co.tax.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code" />
                <field name="name" />
                <field name="is_withholding_tax" widget="boolean_toggle" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="l10n_co_tax_type_action_window">
        <field name="name">Tipo de impuesto</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">l10n_co.tax.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Sin tipos de impuesto definidos
            </p>
        </field>
    </record>
</odoo>
