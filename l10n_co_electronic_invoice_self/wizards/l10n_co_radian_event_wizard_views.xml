<odoo>
    <record id="l10n_co_radian_event_wizard_form" model="ir.ui.view">
        <field name="name">l10n_co.dian.radian.event.wizard.form</field>
        <field name="model">l10n_co.dian.radian.event.wizard</field>
        <field name="arch" type="xml">
            <form string="Enviar Evento RADIAN">
                <group>
                    <field name="move_id" readonly="1" />
                    <field name="event_type" />
                    <field name="note" />
                </group>
                <footer>
                    <button
                        name="action_send_event"
                        string="Enviar Evento"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancelar" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
