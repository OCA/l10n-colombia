<odoo>
    <template
        id="dian_numbering_range_query_content"
        name="Consulta de Rango de Numeración para la DIAN"
    >
        <wcf:GetNumberingRange xmlns:wcf="http://wcf.dian.colombia">
            <wcf:accountCode>
                <t t-esc="record.company_id.vat.replace('.', '').split('-')[0]" />
            </wcf:accountCode>
            <wcf:accountCodeT>
                <t t-esc="record.company_id.vat.replace('.', '').split('-')[0]" />
            </wcf:accountCodeT>
            <wcf:softwareCode>
                <t t-esc="record.l10n_co_dian_software_identification" />
            </wcf:softwareCode>
        </wcf:GetNumberingRange>
    </template>
</odoo>
