<odoo>
    <!-- Template principal para nota crédito UBL -->
    <template id="dian_credit_note_ubl_content" name="DIAN Credit Note UBL Content">
        <t t-set="credit_note" t-value="record" />
        <t t-set="company" t-value="credit_note.company_id" />
        <t t-set="partner" t-value="credit_note.partner_id" />

        <CreditNote
            xmlns="urn:oasis:names:specification:ubl:schema:xsd:CreditNote-2"
            xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
            xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2"
        >
            <!-- Versión UBL -->
            <cbc:UBLVersionID>UBL 2.1</cbc:UBLVersionID>

            <!-- ID del documento -->
            <cbc:ID>
                <t t-esc="credit_note.name" />
            </cbc:ID>

            <!-- Fecha de emisión -->
            <cbc:IssueDate>
                <t t-esc="credit_note.invoice_date" />
            </cbc:IssueDate>

            <!-- Moneda del documento -->
            <cbc:DocumentCurrencyCode>
                <t t-esc="credit_note.currency_id.name" />
            </cbc:DocumentCurrencyCode>

            <!-- Referencia a la factura original -->
            <t t-if="credit_note.reversed_entry_id">
                <cac:BillingReference>
                    <cac:InvoiceDocumentReference>
                        <cbc:ID>
                            <t t-esc="credit_note.reversed_entry_id.name" />
                        </cbc:ID>
                        <cbc:IssueDate>
                            <t t-esc="credit_note.reversed_entry_id.invoice_date" />
                        </cbc:IssueDate>
                    </cac:InvoiceDocumentReference>
                </cac:BillingReference>
            </t>

            <!-- Proveedor (Empresa emisora) -->
            <cac:AccountingSupplierParty>
                <cac:Party>
                    <cac:PartyName>
                        <cbc:Name>
                            <t t-esc="company.name" />
                        </cbc:Name>
                    </cac:PartyName>
                    <cac:PartyTaxScheme>
                        <cbc:RegistrationName>
                            <t t-esc="company.name" />
                        </cbc:RegistrationName>
                        <cbc:CompanyID>
                            <t t-esc="company.vat" />
                        </cbc:CompanyID>
                        <cac:TaxScheme>
                            <cbc:ID>01</cbc:ID>
                            <cbc:Name>IVA</cbc:Name>
                        </cac:TaxScheme>
                    </cac:PartyTaxScheme>
                </cac:Party>
            </cac:AccountingSupplierParty>

            <!-- Cliente -->
            <cac:AccountingCustomerParty>
                <cac:Party>
                    <cac:PartyName>
                        <cbc:Name>
                            <t t-esc="partner.name" />
                        </cbc:Name>
                    </cac:PartyName>
                    <cac:PartyTaxScheme>
                        <cbc:RegistrationName>
                            <t t-esc="partner.name" />
                        </cbc:RegistrationName>
                        <cbc:CompanyID>
                            <t t-esc="partner.vat" />
                        </cbc:CompanyID>
                        <cac:TaxScheme>
                            <cbc:ID>01</cbc:ID>
                            <cbc:Name>IVA</cbc:Name>
                        </cac:TaxScheme>
                    </cac:PartyTaxScheme>
                </cac:Party>
            </cac:AccountingCustomerParty>

            <!-- Líneas de la nota crédito -->
            <t
                t-foreach="credit_note.invoice_line_ids.filtered(lambda l: l.display_type == 'product')"
                t-as="line"
            >
                <cac:CreditNoteLine>
                    <cbc:ID>
                        <t t-esc="line_index + 1" />
                    </cbc:ID>
                    <cbc:CreditedQuantity
                        t-att-unitCode="line.product_uom_id.unece_code_id.code or 'NIU'"
                    >
                        <t t-esc="abs(line.quantity)" />
                    </cbc:CreditedQuantity>
                    <cbc:LineExtensionAmount
                        t-att-currencyID="credit_note.currency_id.name"
                    >
                        <t t-esc="abs(line.price_subtotal)" />
                    </cbc:LineExtensionAmount>

                    <!-- Producto/Servicio -->
                    <cac:Item>
                        <cbc:Description>
                            <t t-esc="line.name" />
                        </cbc:Description>
                        <cac:SellersItemIdentification>
                            <cbc:ID>
                                <t
                                    t-esc="line.product_id.default_code or line.product_id.id"
                                />
                            </cbc:ID>
                        </cac:SellersItemIdentification>
                    </cac:Item>

                    <!-- Precio -->
                    <cac:Price>
                        <cbc:PriceAmount
                            t-att-currencyID="credit_note.currency_id.name"
                        >
                            <t t-esc="abs(line.price_unit)" />
                        </cbc:PriceAmount>
                        <cbc:BaseQuantity
                            t-att-unitCode="line.product_uom_id.unece_code_id.code or 'NIU'"
                        >1</cbc:BaseQuantity>
                    </cac:Price>
                </cac:CreditNoteLine>
            </t>

            <!-- Totales -->
            <cac:LegalMonetaryTotal>
                <cbc:LineExtensionAmount
                    t-att-currencyID="credit_note.currency_id.name"
                >
                    <t t-esc="abs(credit_note.amount_untaxed)" />
                </cbc:LineExtensionAmount>
                <cbc:TaxExclusiveAmount t-att-currencyID="credit_note.currency_id.name">
                    <t t-esc="abs(credit_note.amount_untaxed)" />
                </cbc:TaxExclusiveAmount>
                <cbc:TaxInclusiveAmount t-att-currencyID="credit_note.currency_id.name">
                    <t t-esc="abs(credit_note.amount_total)" />
                </cbc:TaxInclusiveAmount>
                <cbc:PayableAmount t-att-currencyID="credit_note.currency_id.name">
                    <t t-esc="abs(credit_note.amount_total)" />
                </cbc:PayableAmount>
            </cac:LegalMonetaryTotal>
        </CreditNote>
    </template>
</odoo>
