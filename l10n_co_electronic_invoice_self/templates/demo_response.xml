<odoo>
    <!-- Respuesta simulada para SendBillSync en modo demostración -->
    <template
        id="dian_demo_send_bill_sync_response"
        name="DIAN Demo SendBillSync Response"
    >
        <s:Envelope
            xmlns:s="http://schemas.xmlsoap.org/soap/envelope/"
            xmlns:o="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd"
            xmlns:u="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd"
        >
            <s:Header>
                <o:Security>
                    <u:Timestamp>
                        <u:Created t-out="created" />
                    </u:Timestamp>
                </o:Security>
            </s:Header>
            <s:Body>
                <SendBillSyncResponse xmlns="http://wcf.dian.colombia">
                    <SendBillSyncResult
                        xmlns:b="http://schemas.datacontract.org/2004/07/UploadDocumentResponse"
                    >
                        <b:StatusCode>00</b:StatusCode>
                        <b:StatusDescription
                        >[DEMO] Documento validado (simulación)</b:StatusDescription>
                        <b:StatusMessage
                        >Documento procesado en modo demostración</b:StatusMessage>
                        <b:XmlDocumentKey t-out="xml_document_key" />
                    </SendBillSyncResult>
                </SendBillSyncResponse>
            </s:Body>
        </s:Envelope>
    </template>

