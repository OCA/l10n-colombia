<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_withholding_certificate" model="ir.actions.report">
        <field name="name">Withholding Certificate</field>
        <field name="model">l10n_co.withholding.certificate.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_co_withholding_certificate.rte_fte_certificate</field>
        <field name="report_file">l10n_co_withholding_certificate.rte_fte_certificate</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_user'))]"/>
        <field name="print_report_name">'Certificado_ReteFuente_%s' % (object.fiscal_year)</field>
    </record>
    <record id="action_report_withholding_iva_certificate" model="ir.actions.report">
        <field name="name">IVA Withholding Certificate</field>
        <field name="model">l10n_co.withholding.certificate.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_co_withholding_certificate.rte_fte_certificate</field>
        <field name="report_file">l10n_co_withholding_certificate.rte_fte_certificate</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_user'))]"/>
        <field name="print_report_name">'Certificado_ReteIVA_%s' % (object.fiscal_year)</field>
    </record>
    <record id="action_report_withholding_ica_certificate" model="ir.actions.report">
        <field name="name">ICA Withholding Certificate</field>
        <field name="model">l10n_co.withholding.certificate.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_co_withholding_certificate.rte_fte_certificate</field>
        <field name="report_file">l10n_co_withholding_certificate.rte_fte_certificate</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_user'))]"/>
        <field name="print_report_name">'Certificado_ReteICA_%s' % (object.fiscal_year)</field>
    </record>
</odoo>
