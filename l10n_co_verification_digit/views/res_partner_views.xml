<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.l10n_co_verification_digit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="l10n_latam_base.view_partner_latam_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <span
                    class="oe_inline"
                    invisible="l10n_latam_identification_type_id != %(l10n_co.rut)d"
                > - </span>
                <field
                    name="l10n_co_verification_digit"
                    class="o_field_inline"
                    nolabel="1"
                    invisible="l10n_latam_identification_type_id != %(l10n_co.rut)d"
                    readonly="parent_id"
                />
            </xpath>
        </field>
    </record>
</odoo>
