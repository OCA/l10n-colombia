<odoo noupdate="1">

    <!-- ====================== Salary Rule Categories ====================== -->
    <record id="category_basic" model="hr.salary.rule.category">
        <field name="name">Salario Básico</field>
        <field name="code">BASIC</field>
    </record>
    <record id="category_salarial" model="hr.salary.rule.category">
        <field name="name">Otros Devengados Salariales</field>
        <field name="code">SALARIAL</field>
    </record>
    <record id="category_no_salarial" model="hr.salary.rule.category">
        <field name="name">Devengados No Salariales</field>
        <field name="code">NO_SALARIAL</field>
    </record>
    <record id="category_deduction" model="hr.salary.rule.category">
        <field name="name">Deducciones</field>
        <field name="code">DEDUCTION</field>
    </record>
    <record id="category_net" model="hr.salary.rule.category">
        <field name="name">Neto a Pagar</field>
        <field name="code">NET</field>
    </record>
    <record id="category_employer_ss" model="hr.salary.rule.category">
        <field name="name">Seguridad Social a Cargo del Empleador</field>
        <field name="code">EMPLOYER_SS</field>
    </record>
    <record id="category_parafiscal" model="hr.salary.rule.category">
        <field name="name">Aportes Parafiscales</field>
        <field name="code">PARAFISCAL</field>
    </record>
    <record id="category_provision" model="hr.salary.rule.category">
        <field name="name">Provisiones de Prestaciones Sociales</field>
        <field name="code">PROVISION</field>
    </record>

    <!-- ====================== Contribution Registers ====================== -->
    <record id="register_eps" model="hr.contribution.register">
        <field name="name">Colombia: EPS (Security Health) Payable</field>
        <field name="note">Aportes a la EPS (salud). Asigne aquí el partner de
            la Entidad Promotora de Salud de cada compañía para que el asiento
            contable de nómina genere la cuenta por pagar a ese tercero.</field>
    </record>
    <record id="register_fp" model="hr.contribution.register">
        <field name="name">Colombia: AFP (Pension Fund) Payable</field>
        <field name="note">Aportes al fondo de pensiones (AFP). Asigne el
            partner de la administradora de pensiones.</field>
    </record>
    <record id="register_arl" model="hr.contribution.register">
        <field name="name">Colombia: ARL Payable</field>
        <field name="note">Aportes riesgos laborales. Asigne el partner de la
            Administradora de Riesgos Laborales.</field>
    </record>
    <record id="register_ccf" model="hr.contribution.register">
        <field name="name">Colombia: Parafiscales (CCF/SENA/ICBF) Payable</field>
        <field name="note">Aportes parafiscales: Caja de Compensación Familiar,
            SENA e ICBF. Asigne el partner de la Caja de Compensación a la que
            pertenece la compañía.</field>
    </record>

    <!-- ====================== Salary Rules ====================== -->
    <record id="salary_rule_basic" model="hr.salary.rule">
        <field name="name">Salario Básico</field>
        <field name="code">BASIC</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="category_basic" />
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# result = contract.wage
result = contract.wage
        </field>
        <field name="note">Salario mensual pactado en el contrato (2026: SMMLV
1.750.905 COP). Se liquida completo para periodos completos.</field>
    </record>

    <record id="salary_rule_extras" model="hr.salary.rule">
        <field name="name">Horas Extras y Recargos</field>
        <field name="code">EXTRAS</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="category_salarial" />
        <field name="condition_select">python</field>
        <field name="condition_python">
result = inputs.EXTRAS and inputs.EXTRAS.amount > 0
        </field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = inputs.EXTRAS and inputs.EXTRAS.amount or 0.0
        </field>
        <field name="note">El valor se ingresa en la pestaña de inputs del
recibo, con el código EXTRAS (horas extras diurnas/nocturnas y recargos ya
valorizados según Ley 2466 de 2025).</field>
    </record>
    <record id="input_extras" model="hr.rule.input">
        <field name="name">Horas Extras y Recargos</field>
        <field name="code">EXTRAS</field>
        <field name="input_id" ref="salary_rule_extras" />
    </record>

    <record id="salary_rule_commissions" model="hr.salary.rule">
        <field name="name">Comisiones y Ventas</field>
        <field name="code">COMMISSIONS</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="category_salarial" />
        <field name="condition_select">python</field>
        <field name="condition_python">
result = inputs.COMMISSIONS and inputs.COMMISSIONS.amount > 0
        </field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = inputs.COMMISSIONS and inputs.COMMISSIONS.amount or 0.0
        </field>
        <field name="note">Comisiones y otros ingresos salariales variables
pagadas al trabajador.</field>
    </record>
    <record id="input_commissions" model="hr.rule.input">
        <field name="name">Comisiones y Ventas</field>
        <field name="code">COMMISSIONS</field>
        <field name="input_id" ref="salary_rule_commissions" />
    </record>

    <record id="salary_rule_other_salary" model="hr.salary.rule">
        <field name="name">Otros Devengados Salariales</field>
        <field name="code">OTHER_SALARY</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="category_salarial" />
        <field name="condition_select">python</field>
        <field name="condition_python">
result = inputs.OTHER_SALARY and inputs.OTHER_SALARY.amount > 0
        </field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = inputs.OTHER_SALARY and inputs.OTHER_SALARY.amount or 0.0
        </field>
        <field name="note">Otros devengados que constituyen salario y hacen
parte del IBC (bonificaciones salariales, viáticos permanentes, etc.).</field>
    </record>
    <record id="input_other_salary" model="hr.rule.input">
        <field name="name">Otros Devengados Salariales</field>
        <field name="code">OTHER_SALARY</field>
        <field name="input_id" ref="salary_rule_other_salary" />
    </record>

    <record id="salary_rule_aux_transport" model="hr.salary.rule">
        <field name="name">Auxilio de Transporte</field>
        <field name="code">AUX_TRANSPORT</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="category_no_salarial" />
        <field name="condition_select">python</field>
        <field name="condition_python">
result = (
    contract.l10n_co_auxiliary_transport
    and not (contract.wage > contract.company_id.l10n_co_max_salary_transport)
)
        </field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = contract.company_id.l10n_co_transport_assistance
        </field>
        <field name="note">Auxilio de transporte: se reconoce si el trabajador
devenga hasta 2 SMMLV. No constituye salario, no hace parte del IBC, pero sí
de la base para prima y cesantías.</field>
    </record>

    <record id="salary_rule_health_employee" model="hr.salary.rule">
        <field name="name">Aporte a Salud (Trabajador)</field>
        <field name="code">HEALTH_EMP_DEDUCTION</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="category_deduction" />
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = -(
    (categories.BASIC + categories.SALARIAL)
    * contract.company_id.l10n_co_health_employee_percentage
    / 100.0
)
        </field>
        <field name="register_id" ref="register_eps" />
        <field name="note">Aporte del trabajador al Sistema de Salud (4% del
IBC). Valor negativo: se deduce del salario y se paga a la EPS.</field>
    </record>

    <record id="salary_rule_pension_employee" model="hr.salary.rule">
        <field name="name">Aporte a Pensión (Trabajador)</field>
        <field name="code">PENSION_EMP_DEDUCTION</field>
        <field name="sequence">70</field>
        <field name="category_id" ref="category_deduction" />
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = -(
    (categories.BASIC + categories.SALARIAL)
    * contract.company_id.l10n_co_pension_employee_percentage
    / 100.0
)
        </field>
        <field name="register_id" ref="register_fp" />
        <field name="note">Aporte del trabajador al Sistema de Pensiones (4%
del IBC). Valor negativo: se deduce del salario y se paga a la AFP.</field>
    </record>

    <record id="salary_rule_other_deductions" model="hr.salary.rule">
        <field name="name">Otras Deducciones</field>
        <field name="code">OTHER_DEDUCTIONS</field>
        <field name="sequence">80</field>
        <field name="category_id" ref="category_deduction" />
        <field name="condition_select">python</field>
        <field name="condition_python">
result = inputs.OTHER_DEDUCTIONS and inputs.OTHER_DEDUCTIONS.amount > 0
        </field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = -(inputs.OTHER_DEDUCTIONS and inputs.OTHER_DEDUCTIONS.amount or 0.0)
        </field>
        <field name="note">Otras deducciones autorizadas: libranzas, embargos
judiciales, cooperativas, etc. Valor negativo: reduce el neto a pagar.</field>
    </record>
    <record id="input_other_deductions" model="hr.rule.input">
        <field name="name">Otras Deducciones</field>
        <field name="code">OTHER_DEDUCTIONS</field>
        <field name="input_id" ref="salary_rule_other_deductions" />
    </record>

    <record id="salary_rule_net" model="hr.salary.rule">
        <field name="name">Neto a Pagar</field>
        <field name="code">NET</field>
        <field name="sequence">90</field>
        <field name="category_id" ref="category_net" />
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = (
    categories.BASIC
    + categories.SALARIAL
    + categories.NO_SALARIAL
    + categories.DEDUCTION
)
        </field>
        <field name="note">Valor neto a pagar al trabajador = total devengado -
total deducciones (las deducciones se liquidan en negativo).</field>
    </record>

    <record id="salary_rule_health_employer" model="hr.salary.rule">
        <field name="name">Aporte a Salud (Empleador)</field>
        <field name="code">HEALTH_EMPLOYER</field>
        <field name="sequence">200</field>
        <field name="category_id" ref="category_employer_ss" />
        <field name="condition_select">python</field>
        <field name="condition_python">
result = not contract.company_id.l10n_co_exempt_health_parafiscal
        </field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = (
    (categories.BASIC + categories.SALARIAL)
    * contract.company_id.l10n_co_health_employer_percentage
    / 100.0
)
        </field>
        <field name="register_id" ref="register_eps" />
        <field name="note">Aporte del empleador a salud (8,5% del IBC). Se
exonera cuando el empleador cumple el art. 114-1 del ET (todos los
trabajadores ganan menos de 10 SMMLV).</field>
    </record>

    <record id="salary_rule_pension_employer" model="hr.salary.rule">
        <field name="name">Aporte a Pensión (Empleador)</field>
        <field name="code">PENSION_EMPLOYER</field>
        <field name="sequence">210</field>
        <field name="category_id" ref="category_employer_ss" />
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = (
    (categories.BASIC + categories.SALARIAL)
    * contract.company_id.l10n_co_pension_employer_percentage
    / 100.0
)
        </field>
        <field name="register_id" ref="register_fp" />
        <field name="note">Aporte del empleador a pensión (12% del IBC).</field>
    </record>

    <record id="salary_rule_arl" model="hr.salary.rule">
        <field name="name">Riesgos Laborales (ARL)</field>
        <field name="code">ARL</field>
        <field name="sequence">220</field>
        <field name="category_id" ref="category_employer_ss" />
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = (
    (categories.BASIC + categories.SALARIAL)
    * contract.l10n_co_arl_rate
    / 100.0
)
        </field>
        <field name="register_id" ref="register_arl" />
        <field name="note">Aporte a riesgos laborales según la clase de riesgo
del contrato: I=0,522%, II=1,044%, III=2,436%, IV=4,350%, V=6,960%.</field>
    </record>

    <record id="salary_rule_parafiscal_ccf" model="hr.salary.rule">
        <field name="name">Caja de Compensación Familiar</field>
        <field name="code">PARAFISCAL_CCF</field>
        <field name="sequence">230</field>
        <field name="category_id" ref="category_parafiscal" />
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = (
    (categories.BASIC + categories.SALARIAL)
    * contract.company_id.l10n_co_parafiscal_ccf_percentage
    / 100.0
)
        </field>
        <field name="register_id" ref="register_ccf" />
        <field name="note">Aporte parafiscal a la Caja de Compensación Familiar
(4% del IBC). Se causa siempre, sin importar la exoneración del art. 114-1 ET.</field>
    </record>

    <record id="salary_rule_parafiscal_sena" model="hr.salary.rule">
        <field name="name">SENA</field>
        <field name="code">PARAFISCAL_SENA</field>
        <field name="sequence">240</field>
        <field name="category_id" ref="category_parafiscal" />
        <field name="condition_select">python</field>
        <field name="condition_python">
result = not contract.company_id.l10n_co_exempt_health_parafiscal
        </field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = (
    (categories.BASIC + categories.SALARIAL)
    * contract.company_id.l10n_co_parafiscal_sena_percentage
    / 100.0
)
        </field>
        <field name="register_id" ref="register_ccf" />
        <field name="note">Aporte parafiscal SENA (2% del IBC). Exonerado cuando
se cumple el art. 114-1 ET.</field>
    </record>

    <record id="salary_rule_parafiscal_icbf" model="hr.salary.rule">
        <field name="name">ICBF</field>
        <field name="code">PARAFISCAL_ICBF</field>
        <field name="sequence">250</field>
        <field name="category_id" ref="category_parafiscal" />
        <field name="condition_select">python</field>
        <field name="condition_python">
result = not contract.company_id.l10n_co_exempt_health_parafiscal
        </field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = (
    (categories.BASIC + categories.SALARIAL)
    * contract.company_id.l10n_co_parafiscal_icbf_percentage
    / 100.0
)
        </field>
        <field name="register_id" ref="register_ccf" />
        <field name="note">Aporte parafiscal ICBF (3% del IBC). Exonerado cuando
se cumple el art. 114-1 ET.</field>
    </record>

    <record id="salary_rule_provision_prima" model="hr.salary.rule">
        <field name="name">Provisión Prima de Servicios</field>
        <field name="code">PROVISION_PRIMA</field>
        <field name="sequence">300</field>
        <field name="category_id" ref="category_provision" />
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = (
    (categories.BASIC + categories.SALARIAL + categories.NO_SALARIAL)
    * contract.company_id.l10n_co_provision_prima_percentage
    / 100.0
)
        </field>
        <field name="note">Provisión mensual de la prima de servicios (20 días
según Código Sustantivo del Trabajo → 8,33%): base = salario + auxilio de
transporte.</field>
    </record>

    <record id="salary_rule_provision_cesantias" model="hr.salary.rule">
        <field name="name">Provisión Cesantías</field>
        <field name="code">PROVISION_CESANTIAS</field>
        <field name="sequence">310</field>
        <field name="category_id" ref="category_provision" />
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = (
    (categories.BASIC + categories.SALARIAL + categories.NO_SALARIAL)
    * contract.company_id.l10n_co_provision_cesantias_percentage
    / 100.0
)
        </field>
        <field name="note">Provisión mensual de cesantías (30 días → 8,33%):
base = salario + auxilio de transporte.</field>
    </record>

    <record id="salary_rule_provision_intereses" model="hr.salary.rule">
        <field name="name">Provisión Intereses a las Cesantías</field>
        <field name="code">PROVISION_INTERESES</field>
        <field name="sequence">320</field>
        <field name="category_id" ref="category_provision" />
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = (
    PROVISION_CESANTIAS
    * contract.company_id.l10n_co_provision_interests_percentage
    / 100.0
)
        </field>
        <field name="note">Provisión mensual de intereses a las cesantías
(12% anual → 1% mensual) calculada sobre la provisión de cesantías.</field>
    </record>

    <record id="salary_rule_provision_vacaciones" model="hr.salary.rule">
        <field name="name">Provisión Vacaciones</field>
        <field name="code">PROVISION_VACACIONES</field>
        <field name="sequence">330</field>
        <field name="category_id" ref="category_provision" />
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = (
    (categories.BASIC + categories.SALARIAL)
    * contract.company_id.l10n_co_provision_vacaciones_percentage
    / 100.0
)
        </field>
        <field name="note">Provisión mensual de vacaciones (15 días → 4,17%): se
calcula solo sobre el salario, sin auxilio de transporte.</field>
    </record>

    <!-- ====================== Salary Structures ====================== -->
    <record id="structure_colombia" model="hr.payroll.structure">
        <field name="name">Estructura Nómina Colombia</field>
        <field name="code">COLOMBIA</field>
        <field name="note">
            Estructura general de nómina colombiana. Las estructuras concretas
            (mensual, quincenal...) cuelgan de esta.
        </field>
    </record>
    <record id="structure_colombia_monthly" model="hr.payroll.structure">
        <field name="name">Nómina Mensual Colombia</field>
        <field name="code">COLOMBIA_MONTHLY</field>
        <field name="parent_id" ref="structure_colombia" />
        <field name="rule_ids" eval="[
            (4, ref('salary_rule_basic')),
            (4, ref('salary_rule_extras')),
            (4, ref('salary_rule_commissions')),
            (4, ref('salary_rule_other_salary')),
            (4, ref('salary_rule_aux_transport')),
            (4, ref('salary_rule_health_employee')),
            (4, ref('salary_rule_pension_employee')),
            (4, ref('salary_rule_other_deductions')),
            (4, ref('salary_rule_net')),
            (4, ref('salary_rule_health_employer')),
            (4, ref('salary_rule_pension_employer')),
            (4, ref('salary_rule_arl')),
            (4, ref('salary_rule_parafiscal_ccf')),
            (4, ref('salary_rule_parafiscal_sena')),
            (4, ref('salary_rule_parafiscal_icbf')),
            (4, ref('salary_rule_provision_prima')),
            (4, ref('salary_rule_provision_cesantias')),
            (4, ref('salary_rule_provision_intereses')),
            (4, ref('salary_rule_provision_vacaciones')),
        ]" />
    </record>

</odoo>