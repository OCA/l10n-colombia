<odoo>
    <record id="hr_contract_view_form_l10n_co" model="ir.ui.view">
        <field name="name">hr.contract.view.form.l10n.co.payroll</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="payroll.hr_contract_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='salary']" position="inside">
                <field name="l10n_co_auxiliary_transport" />
                <field name="l10n_co_arl_risk_class" />
                <field name="l10n_co_arl_rate" />
            </xpath>
        </field>
    </record>
</odoo>