<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form_l10n_co_withholding" model="ir.ui.view">
        <field name="name">account.move.form.l10n_co_withholding</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_post']" position="before">
                <button
                    name="l10n_co_compute_withholding_taxes"
                    type="object"
                    string="Calcular Retenciones"
                    invisible="state != 'draft' or move_type not in ('in_invoice', 'in_refund', 'out_invoice', 'out_refund')"
                    class="btn-secondary"
                />
            </xpath>
        </field>
    </record>
</odoo>
